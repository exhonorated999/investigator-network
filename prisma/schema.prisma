// Investigator Network LMS — Prisma schema (v1)
// Datasource: PostgreSQL (Railway). Storage of uploaded files lives on a
// persistent volume; only metadata is stored here (FileUpload).

generator client {
  provider = "prisma-client-js"
  // Generated inside the project tree: Turbopack (Next 16) cannot resolve the
  // dynamic `.prisma/client` indirection inside node_modules.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB13AFA07B_DATABASE_URL")
  directUrl = env("DB13AFA07B_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users, roles, approval gating
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  ADMIN
}

/// Which side of the platform a person (or a course) belongs to. Active
/// law-enforcement is the original audience; CIVILIAN is the walled-off
/// private-investigator / CDFIR side. A user has exactly one audience; a
/// course can serve one or both. Admins are audience-neutral (see everything).
enum Audience {
  LE
  CIVILIAN
}

enum UserStatus {
  PENDING
  APPROVED
  DENIED
  SUSPENDED
  /// Soft-deleted by an admin. Cannot log in, hidden from directories, but the
  /// row (and all history) is retained so the account can be restored later.
  REMOVED
}

model User {
  id           String     @id @default(cuid())
  name         String
  agency       String
  email        String     @unique
  /// Null means the account has no usable password yet — it was created by an
  /// admin or migrated from the legacy platform and is waiting for the user to
  /// set one via an activation link (see InviteToken). Such accounts can never
  /// sign in with credentials until they activate.
  passwordHash String?
  role         Role       @default(LEARNER)
  /// The platform owner. Exactly one account (the Inv-Network admin) holds this.
  /// A super admin can create and remove other admins and can never be removed
  /// or suspended by anyone — including other admins.
  isSuperAdmin Boolean    @default(false)
  status       UserStatus @default(PENDING)
  /// LE (default) or CIVILIAN. Set at registration or by an admin. Drives
  /// what courses, community topics, news and DM contacts the user can see.
  audience     Audience   @default(LE)
  /// US state / region collected at registration. Free-text, optional.
  state        String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?      @relation("Approvals", fields: [approvedById], references: [id])
  approvedUsers User[]    @relation("Approvals")

  enrollments   Enrollment[]
  unitProgress  UnitProgress[]
  interactions  BlockInteraction[]
  attempts      Attempt[]
  quizDrafts    QuizDraft[]
  uploads       FileUpload[]
  certificates  Certificate[]
  gradedAnswers Answer[]        @relation("GradedBy")
  dashboardPref DashboardPref?
  favorites     CourseFavorite[]
  articles      NewsArticle[]

  posts        Post[]
  postComments PostComment[]
  reactions    PostReaction[]
  convoParts   ConversationParticipant[]
  messagesSent Message[]
  courseQuestions CourseQuestion[]
  courseAnswers   CourseAnswer[]
  courseActivity  CourseActivity[]
  inviteTokens    InviteToken[]

  /// Provenance for accounts migrated off the legacy LearnWorlds site. Holds
  /// the legacy user id so re-running the importer is idempotent, plus when the
  /// migration happened. Null for accounts created natively here.
  legacyId   String?   @unique
  importedAt DateTime?

  /// True when the current password is a temporary/bootstrap credential the user
  /// did not choose (e.g. the shared migration password). Every authenticated
  /// area redirects such a session to /change-password until they pick their own.
  mustChangePassword Boolean @default(false)

  /// Presence — last time this user's browser sent a heartbeat. A user counts
  /// as "online" if this is within the presence window (see lib/presence.ts).
  lastSeenAt       DateTime?
  /// Where they were when that heartbeat fired, so staff can see not just who
  /// is online but what they are working on. Denormalized on purpose: this is
  /// throwaway telemetry, and a relation would force a join on every poll.
  lastSeenPath     String?
  lastSeenCourseId String?
  lastSeenCourse   Course?  @relation("PresenceCourse", fields: [lastSeenCourseId], references: [id], onDelete: SetNull)
  lastSeenUnitId   String?

  @@index([status])
  @@index([lastSeenAt])
}

/// Why a token was issued. ACTIVATION is a first-time credential handout (new
/// account or migrated legacy account); PASSWORD_RESET is a recovery link for
/// an account that already has a password.
enum InviteTokenPurpose {
  ACTIVATION
  PASSWORD_RESET
}

/// Single-use, expiring link that lets a user set their own password without an
/// admin ever handling plaintext. Only a SHA-256 hash of the token is stored,
/// so a database leak cannot be replayed into account takeovers — the raw token
/// exists only in the URL handed to the user.
model InviteToken {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String             @unique
  purpose     InviteTokenPurpose @default(ACTIVATION)
  expiresAt   DateTime
  /// Set the moment the token is redeemed. A used token is dead forever.
  usedAt      DateTime?
  /// Free-text provenance, e.g. "legacy-import 2026-08-04" or an admin id, so
  /// you can tell where a batch of links came from.
  issuedBy    String             @default("")
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Course structure
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum UnitType {
  VIDEO
  NOTES
  LIVE_SESSION
  FILE_ASSIGNMENT
  QUIZ
  CERTIFICATE
}

/// Library classification for a course. FREE courses are open to any eligible
/// learner; PAID courses are surfaced separately in the library so operators
/// can distinguish premium offerings. (Classification only — no checkout.)
enum Pricing {
  FREE
  PAID
}

model Category {
  id       String        @id @default(cuid())
  name     String        @unique
  courses  Course[]
  articles NewsArticle[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @default("")
  coverImage  String?
  status      CourseStatus @default(DRAFT)
  /// Audiences this course serves. Can be [LE], [CIVILIAN], or both. A civilian
  /// only sees courses whose audiences include CIVILIAN; LE only sees LE. Admins
  /// see all. Defaults to [LE] so existing courses stay law-enforcement.
  audiences   Audience[]   @default([LE])
  /// Private courses never appear in the library; a student must be manually
  /// enrolled by an admin to see them.
  isPrivate   Boolean      @default(false)
  /// Library pricing classification (FREE / PAID). Drives the Free/Paid toggle
  /// in the learner library. Defaults to FREE.
  pricing     Pricing      @default(FREE)
  /// Instructor of record — printed on the completion certificate. Free-text
  /// so each course can name its own instructor.
  instructor  String       @default("")
  /// Accredited training hours for this course — printed on the certificate.
  /// Null = not set (hidden on the certificate).
  trainingHours Float?
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections     Section[]
  enrollments  Enrollment[]
  certificates Certificate[]
  favorites    CourseFavorite[]
  questions    CourseQuestion[]
  activity     CourseActivity[]
  presentUsers User[]           @relation("PresenceCourse")
}

model Section {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)
  units    Unit[]

  @@index([courseId])
}

model Unit {
  id             String   @id @default(cuid())
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String
  type           UnitType
  order          Int      @default(0)
  completionRule String?
  // Type-specific payload stored as JSON:
  //  VIDEO           -> { youtubeId, durationSec }
  //  NOTES           -> { contentMarkdown, pdfFileId? }
  //  LIVE_SESSION    -> { teamsJoinUrl, startsAt, durationMin, replayUrl? }
  //  FILE_ASSIGNMENT -> { prompt, allowedFileTypes }
  //  CERTIFICATE     -> { templateId }
  data           Json     @default("{}")

  quiz     Quiz?
  progress UnitProgress[]
  interactions BlockInteraction[]

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Enrollment & progress
// ---------------------------------------------------------------------------

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

enum ProgressStatus {
  INCOMPLETE
  COMPLETE
}

model UnitProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(INCOMPLETE)
  completedAt DateTime?

  @@unique([userId, unitId])
}

/// A learner's answer to one interactive block inside a NOTES unit.
///
/// Blocks live in a JSON document rather than their own table, so `blockId` is
/// an opaque string with no foreign key — a block can be deleted or re-ordered
/// by an admin at any time and the orphaned row simply stops being read. That
/// looseness is deliberate; the alternative is a migration every time someone
/// edits a page.
///
/// `complete` is derived from `payload` by `isInteractionComplete` in
/// lib/blocks.ts and re-checked server-side on every write. It is denormalized
/// so completion gating is one cheap query instead of re-parsing the document.
model BlockInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  blockId   String
  /// Block type at the time of answering, for analytics that outlive an edit.
  kind      String
  payload   Json     @default("{}")
  complete  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, unitId, blockId])
  @@index([unitId, blockId])
  @@index([userId, unitId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  DOCUMENT_UPLOAD
}

enum AttemptStatus {
  PENDING_GRADING
  GRADED
}

model Quiz {
  id        String     @id @default(cuid())
  unitId    String     @unique
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  passScore Int        @default(70)
  questions Question[]
  attempts  Attempt[]
  drafts    QuizDraft[]
}

/// A learner's in-progress answers for a quiz, saved automatically so a long
/// test can be left and resumed later without losing work. One draft per user
/// per quiz; it is cleared when the learner submits an attempt. Only
/// multiple-choice selections are stored — a browser will not let JavaScript
/// re-populate a file input, so document-upload answers must be re-attached.
model QuizDraft {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// Map of questionId -> selected choice id (single-select) or array of choice
  /// ids (multi-select). Shape mirrors what the submit action expects.
  answers   Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@unique([userId, quizId])
  @@index([quizId])
}

model Question {
  id      String       @id @default(cuid())
  quizId  String
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type    QuestionType
  prompt  String
  order   Int          @default(0)
  points  Int          @default(1)
  /// When true (MULTIPLE_CHOICE only), the learner may tick several choices and
  /// full points are awarded only when the selected set exactly matches the set
  /// of correct choices. Renders as checkboxes instead of radios.
  multiSelect Boolean   @default(false)
  choices Choice[]
  answers Answer[]

  @@index([quizId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  answers    Answer[]

  @@index([questionId])
}

model Attempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime      @default(now())
  score       Int?
  status      AttemptStatus @default(PENDING_GRADING)
  passed      Boolean?
  answers     Answer[]

  @@index([quizId, status])
}

model Answer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId String?
  selectedChoice   Choice?     @relation(fields: [selectedChoiceId], references: [id])
  /// For multi-select questions: the array of chosen choice ids. Null/absent
  /// for single-choice (which uses selectedChoiceId) and upload answers.
  selectedChoiceIds Json?
  uploadedFileId   String?
  uploadedFile     FileUpload? @relation(fields: [uploadedFileId], references: [id])
  awardedPoints    Int?
  feedback         String?
  gradedById       String?
  gradedBy         User?       @relation("GradedBy", fields: [gradedById], references: [id])

  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Files & certificates
// ---------------------------------------------------------------------------

model FileUpload {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  path        String
  filename    String
  mimeType    String
  sizeBytes   Int
  purpose     String
  createdAt   DateTime @default(now())

  answers Answer[]
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt DateTime @default(now())
  serial   String   @unique

  @@unique([userId, courseId])
}

// ---------------------------------------------------------------------------
// Personalised dashboard
// ---------------------------------------------------------------------------

/// Per-user dashboard layout. `widgets` is an ordered array of widget ids;
/// unknown ids are ignored so widgets can be removed safely in future.
model DashboardPref {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets   Json     @default("[]")
  /// Category ids the learner subscribes to in the news feed. An empty array
  /// means "everything" so new categories surface automatically.
  newsTopics Json    @default("[]")
  updatedAt DateTime @updatedAt
}

model CourseFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Curated news feed
// ---------------------------------------------------------------------------

/// An article curated by staff. `body` holds pasted article text (plain text,
/// blank lines separate paragraphs); when empty the card links straight out to
/// `sourceUrl`.
model NewsArticle {
  id         String    @id @default(cuid())
  title      String
  summary    String    @default("")
  body       String    @default("")
  sourceName String    @default("")
  sourceUrl  String    @default("")
  imageUrl   String?
  /// Which side sees this article. null = both sides. Civilian-only articles
  /// (e.g. the Private Investigator News feed) are CIVILIAN; LE-only are LE.
  audience   Audience?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  published  Boolean   @default(true)
  publishedAt DateTime @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Community feed — a topic-tabbed social wall (DFIR / ICAC / General Invest.)
// where members post questions, answer each other, and react. `topic` is a
// code-level constant (see lib/community.ts), not a Category, so the community
// taxonomy stays independent of course/news categories.
// ---------------------------------------------------------------------------

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic     String
  body      String
  imageUrl  String?
  /// Soft-hidden by an admin. Hidden posts disappear from the feed but are not
  /// destroyed, so moderation is reversible.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  reactions PostReaction[]

  @@index([topic, hidden, createdAt])
  @@index([authorId])
}

model PostComment {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Null for a top-level answer; set for a threaded reply to another comment.
  parentId  String?
  parent    PostComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentThread")
  body      String
  hidden    Boolean      @default(false)
  createdAt DateTime     @default(now())

  reactions PostReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

/// A single reaction (kind = helpful / insightful / thanks) on either a post or
/// a comment. One target column is set; the other is null. Uniqueness (one
/// reaction per user per target) is enforced in the server action, since
/// Postgres treats NULLs as distinct in composite unique indexes.
model PostReaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  postId    String?
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([postId])
  @@index([commentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct messages — 1:1 conversations between any two members (incl. staff).
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Bumped whenever a new message lands, so the inbox sorts by recency.
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this participant last opened the thread — drives the unread badge.
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Per-course discussion forum — learners ask questions inside a course; staff
// answer them. Open questions surface on the admin dashboard so they can be
// answered without leaving it. Distinct from the global Community feed (which
// is topic-based, not tied to a course).
// ---------------------------------------------------------------------------

model CourseQuestion {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  /// Marked resolved once an answer satisfies the asker (or staff closes it).
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers   CourseAnswer[]

  @@index([courseId, resolved, createdAt])
  @@index([authorId])
}

model CourseAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  /// True when written by an admin/instructor — rendered as an official answer.
  staff      Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([questionId, createdAt])
}

// ---------------------------------------------------------------------------
// Conferences & trainings feed — upcoming in-person / live events promoted to
// members. Mirrors the Tools/Resources card. Audience-aware so the civilian
// and LE sides can carry different (or shared) listings.
// ---------------------------------------------------------------------------

model Conference {
  id        String    @id @default(cuid())
  name      String
  /// Event start (date + time). Feeds sort and filter on this.
  startsAt  DateTime
  /// Optional end — for multi-day events.
  endsAt    DateTime?
  location  String    @default("")
  about     String    @default("")
  /// Registration / info link.
  url       String    @default("")
  /// null = shown to both sides; otherwise limited to one audience.
  audience  Audience?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Free tools & resources — curated external links surfaced on the learner
// dashboard "Tools & resources" card, grouped by discipline so members can
// toggle between DFIR / Investigations / ICAC. Audience-aware like Conference.
// ---------------------------------------------------------------------------

enum ResourceCategory {
  DFIR
  INVESTIGATIONS
  ICAC
}

model Resource {
  id          String           @id @default(cuid())
  name        String
  /// Short blurb describing what the tool/resource is.
  description String           @default("")
  /// External link to the tool/resource.
  url         String
  category    ResourceCategory
  /// null = shown to both sides; otherwise limited to one audience.
  audience    Audience?
  /// Manual ordering within a category (lower shows first).
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
}

// ---------------------------------------------------------------------------
// Time-on-course tracking — accumulated learner engagement seconds, bucketed
// per calendar day so the admin metrics view can total by week/month/quarter/
// year. Rows are written by recordHeartbeat: each heartbeat adds the elapsed
// gap since the previous heartbeat (capped, so an idle tab can't inflate it)
// to today's bucket for the course the learner was on.
// ---------------------------------------------------------------------------

model CourseActivity {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Calendar day (local midnight) this time was accrued on.
  day      DateTime
  /// Total engaged seconds accrued on this course, this day, by this user.
  seconds  Int      @default(0)

  @@unique([userId, courseId, day])
  @@index([courseId, day])
}

// ---------------------------------------------------------------------------
// Transactional email log — used for send-once idempotency so the live-session
// reminder cron never double-emails a learner for the same session. Deliberately
// relation-free (plain ids) so it's a purely additive table. `kind` namespaces
// different email types (e.g. "live_reminder") in case others are added later.
// ---------------------------------------------------------------------------

model EmailLog {
  id        String   @id @default(cuid())
  kind      String
  /// The live-session Unit id (or other subject id) this email was about.
  unitId    String
  userId    String
  /// Address the email was sent to (denormalized for auditing).
  email     String
  sentAt    DateTime @default(now())

  @@unique([kind, unitId, userId])
  @@index([kind, unitId])
}
