// Investigator Network LMS — Prisma schema (v1)
// Datasource: PostgreSQL (Railway). Storage of uploaded files lives on a
// persistent volume; only metadata is stored here (FileUpload).

generator client {
  provider = "prisma-client-js"
  // Generated inside the project tree: Turbopack (Next 16) cannot resolve the
  // dynamic `.prisma/client` indirection inside node_modules.
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DB13AFA07B_DATABASE_URL")
  directUrl = env("DB13AFA07B_DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users, roles, approval gating
// ---------------------------------------------------------------------------

enum Role {
  LEARNER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  DENIED
  SUSPENDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  agency       String
  email        String     @unique
  passwordHash String
  role         Role       @default(LEARNER)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?      @relation("Approvals", fields: [approvedById], references: [id])
  approvedUsers User[]    @relation("Approvals")

  enrollments   Enrollment[]
  unitProgress  UnitProgress[]
  attempts      Attempt[]
  uploads       FileUpload[]
  certificates  Certificate[]
  gradedAnswers Answer[]        @relation("GradedBy")
  dashboardPref DashboardPref?
  favorites     CourseFavorite[]
  articles      NewsArticle[]

  posts        Post[]
  postComments PostComment[]
  reactions    PostReaction[]
  convoParts   ConversationParticipant[]
  messagesSent Message[]

  /// Presence — last time this user's browser sent a heartbeat. A user counts
  /// as "online" if this is within the presence window (see lib/presence.ts).
  lastSeenAt       DateTime?
  /// Where they were when that heartbeat fired, so staff can see not just who
  /// is online but what they are working on. Denormalized on purpose: this is
  /// throwaway telemetry, and a relation would force a join on every poll.
  lastSeenPath     String?
  lastSeenCourseId String?
  lastSeenCourse   Course?  @relation("PresenceCourse", fields: [lastSeenCourseId], references: [id], onDelete: SetNull)
  lastSeenUnitId   String?

  @@index([status])
  @@index([lastSeenAt])
}

// ---------------------------------------------------------------------------
// Course structure
// ---------------------------------------------------------------------------

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum UnitType {
  VIDEO
  NOTES
  LIVE_SESSION
  FILE_ASSIGNMENT
  QUIZ
  CERTIFICATE
}

model Category {
  id       String        @id @default(cuid())
  name     String        @unique
  courses  Course[]
  articles NewsArticle[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @default("")
  coverImage  String?
  status      CourseStatus @default(DRAFT)
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sections     Section[]
  enrollments  Enrollment[]
  certificates Certificate[]
  favorites    CourseFavorite[]
  presentUsers User[]           @relation("PresenceCourse")
}

model Section {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int    @default(0)
  units    Unit[]

  @@index([courseId])
}

model Unit {
  id             String   @id @default(cuid())
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title          String
  type           UnitType
  order          Int      @default(0)
  completionRule String?
  // Type-specific payload stored as JSON:
  //  VIDEO           -> { youtubeId, durationSec }
  //  NOTES           -> { contentMarkdown, pdfFileId? }
  //  LIVE_SESSION    -> { teamsJoinUrl, startsAt, durationMin, replayUrl? }
  //  FILE_ASSIGNMENT -> { prompt, allowedFileTypes }
  //  CERTIFICATE     -> { templateId }
  data           Json     @default("{}")

  quiz     Quiz?
  progress UnitProgress[]

  @@index([sectionId])
}

// ---------------------------------------------------------------------------
// Enrollment & progress
// ---------------------------------------------------------------------------

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

enum ProgressStatus {
  INCOMPLETE
  COMPLETE
}

model UnitProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(INCOMPLETE)
  completedAt DateTime?

  @@unique([userId, unitId])
}

// ---------------------------------------------------------------------------
// Assessments
// ---------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  DOCUMENT_UPLOAD
}

enum AttemptStatus {
  PENDING_GRADING
  GRADED
}

model Quiz {
  id        String     @id @default(cuid())
  unitId    String     @unique
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  passScore Int        @default(70)
  questions Question[]
  attempts  Attempt[]
}

model Question {
  id      String       @id @default(cuid())
  quizId  String
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type    QuestionType
  prompt  String
  order   Int          @default(0)
  points  Int          @default(1)
  choices Choice[]
  answers Answer[]

  @@index([quizId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  answers    Answer[]

  @@index([questionId])
}

model Attempt {
  id          String        @id @default(cuid())
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime      @default(now())
  score       Int?
  status      AttemptStatus @default(PENDING_GRADING)
  passed      Boolean?
  answers     Answer[]

  @@index([quizId, status])
}

model Answer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedChoiceId String?
  selectedChoice   Choice?     @relation(fields: [selectedChoiceId], references: [id])
  uploadedFileId   String?
  uploadedFile     FileUpload? @relation(fields: [uploadedFileId], references: [id])
  awardedPoints    Int?
  feedback         String?
  gradedById       String?
  gradedBy         User?       @relation("GradedBy", fields: [gradedById], references: [id])

  @@index([attemptId])
}

// ---------------------------------------------------------------------------
// Files & certificates
// ---------------------------------------------------------------------------

model FileUpload {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  path        String
  filename    String
  mimeType    String
  sizeBytes   Int
  purpose     String
  createdAt   DateTime @default(now())

  answers Answer[]
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  issuedAt DateTime @default(now())
  serial   String   @unique

  @@unique([userId, courseId])
}

// ---------------------------------------------------------------------------
// Personalised dashboard
// ---------------------------------------------------------------------------

/// Per-user dashboard layout. `widgets` is an ordered array of widget ids;
/// unknown ids are ignored so widgets can be removed safely in future.
model DashboardPref {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgets   Json     @default("[]")
  /// Category ids the learner subscribes to in the news feed. An empty array
  /// means "everything" so new categories surface automatically.
  newsTopics Json    @default("[]")
  updatedAt DateTime @updatedAt
}

model CourseFavorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Curated news feed
// ---------------------------------------------------------------------------

/// An article curated by staff. `body` holds pasted article text (plain text,
/// blank lines separate paragraphs); when empty the card links straight out to
/// `sourceUrl`.
model NewsArticle {
  id         String    @id @default(cuid())
  title      String
  summary    String    @default("")
  body       String    @default("")
  sourceName String    @default("")
  sourceUrl  String    @default("")
  imageUrl   String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  published  Boolean   @default(true)
  publishedAt DateTime @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Community feed — a topic-tabbed social wall (DFIR / ICAC / General Invest.)
// where members post questions, answer each other, and react. `topic` is a
// code-level constant (see lib/community.ts), not a Category, so the community
// taxonomy stays independent of course/news categories.
// ---------------------------------------------------------------------------

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  topic     String
  body      String
  imageUrl  String?
  /// Soft-hidden by an admin. Hidden posts disappear from the feed but are not
  /// destroyed, so moderation is reversible.
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  PostComment[]
  reactions PostReaction[]

  @@index([topic, hidden, createdAt])
  @@index([authorId])
}

model PostComment {
  id        String       @id @default(cuid())
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Null for a top-level answer; set for a threaded reply to another comment.
  parentId  String?
  parent    PostComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentThread")
  body      String
  hidden    Boolean      @default(false)
  createdAt DateTime     @default(now())

  reactions PostReaction[]

  @@index([postId, createdAt])
  @@index([parentId])
}

/// A single reaction (kind = helpful / insightful / thanks) on either a post or
/// a comment. One target column is set; the other is null. Uniqueness (one
/// reaction per user per target) is enforced in the server action, since
/// Postgres treats NULLs as distinct in composite unique indexes.
model PostReaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  postId    String?
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([postId])
  @@index([commentId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Direct messages — 1:1 conversations between any two members (incl. staff).
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// Bumped whenever a new message lands, so the inbox sorts by recency.
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When this participant last opened the thread — drives the unread badge.
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
