# ---- Investigator Network LMS: environment template ----
# Copy to `.env` and fill in. On Railway, set these as service variables.

# PostgreSQL connection string (Railway Postgres add-on provides this).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Auth.js (NextAuth) secret. Generate: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# Base URL of the app (used by Auth.js for post-login redirects). This MUST
# match the port you actually serve on, or sign-in will bounce the browser to
# a dead port and the user will look permanently logged out. `start.bat`
# derives it from APP_PORT for local dev; set it explicitly in production.
AUTH_URL="http://localhost:3000"

# Directory on the persistent volume where uploaded files are stored.
# On Railway, mount a volume and point this at it (e.g. /data/uploads).
UPLOAD_DIR="./.uploads"

# --- Email (transactional: approval granted/denied, reminders). Optional in dev. ---
# Provider left generic; wire up in lib/email.ts. Example for SMTP:
EMAIL_FROM="no-reply@investigator-network.com"
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""

# --- Video hosting (Bunny Stream) ---
# Stream → your library → API. The numeric Video Library ID.
BUNNY_STREAM_LIBRARY_ID=""
# Optional. Stream → library → Security → "Token Authentication Key".
# When set, every embed URL is signed and expires; leave blank to rely on
# referrer restriction alone.
BUNNY_STREAM_TOKEN_KEY=""
# Seconds a signed embed stays valid. 14400 = 4 hours, enough for the longest
# replay plus pauses.
BUNNY_STREAM_TOKEN_TTL="14400"
# Optional. The library's CDN hostname (e.g. vz-1a2b3c4d.b-cdn.net), used for
# poster frames.
BUNNY_STREAM_PULL_ZONE=""
